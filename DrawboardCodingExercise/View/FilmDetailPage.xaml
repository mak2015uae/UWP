<Page
	x:Class="DrawboardCodingExercise.View.FilmDetailPage"
	xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
	xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
	xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
	xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
	xmlns:valueConverters="using:DrawboardCodingExercise.ValueConverters"
	xmlns:items="using:DrawboardCodingExercise.ViewModel.Items"
	xmlns:designTime="using:DrawboardCodingExercise.ViewModel.DesignTime"
	mc:Ignorable="d"
	Background="{ThemeResource ApplicationPageBackgroundThemeBrush}"
	d:DataContext="{d:DesignInstance designTime:DesignTimeFilmDetailViewModel, IsDesignTimeCreatable=True}">

	<Page.Resources>
		<valueConverters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter" />
	</Page.Resources>

	<Grid>
		<!-- The whole page scrolls: the opening crawl and character list together exceed a narrow window. -->
		<!--
			Both horizontal scroll properties are disabled, not just the mode: a scroll viewer measures its
			content with infinite width in a scrollable direction, which stops wrapping text from ever seeing
			the real viewport width.
		-->
		<ScrollViewer
			HorizontalScrollMode="Disabled"
			HorizontalScrollBarVisibility="Disabled"
			VerticalScrollBarVisibility="Auto"
			Visibility="{Binding HasFilm, Converter={StaticResource BoolToVisibilityConverter}}">
			<!--
				Left-aligned so the reading column stays against the leading edge; MaxWidth caps the line length
				on a wide window. Stretch would centre the column once MaxWidth clamps it, which reads as a
				layout accident rather than a choice.
			-->
			<StackPanel Margin="24,16,24,24" MaxWidth="720" HorizontalAlignment="Left">

				<TextBlock
					Style="{StaticResource SubheaderTextBlockStyle}"
					Text="{Binding Title}"
					TextWrapping="Wrap" />
				<TextBlock
					Margin="0,2,0,16"
					Opacity="0.75"
					Style="{StaticResource BodyTextBlockStyle}"
					Text="{Binding EpisodeLabel}" />

				<Grid ColumnSpacing="16" RowSpacing="8">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="Auto" />
						<ColumnDefinition Width="*" />
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
						<RowDefinition Height="Auto" />
					</Grid.RowDefinitions>

					<TextBlock
						x:Uid="FilmDetailReleaseDateLabel"
						Grid.Row="0"
						Grid.Column="0"
						Opacity="0.75"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="Released" />
					<TextBlock
						Grid.Row="0"
						Grid.Column="1"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="{Binding ReleaseDate}"
						TextWrapping="Wrap" />

					<TextBlock
						x:Uid="FilmDetailDirectorLabel"
						Grid.Row="1"
						Grid.Column="0"
						Opacity="0.75"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="Director" />
					<TextBlock
						Grid.Row="1"
						Grid.Column="1"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="{Binding Director}"
						TextWrapping="Wrap" />

					<TextBlock
						x:Uid="FilmDetailProducerLabel"
						Grid.Row="2"
						Grid.Column="0"
						Opacity="0.75"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="Producer" />
					<TextBlock
						Grid.Row="2"
						Grid.Column="1"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="{Binding Producer}"
						TextWrapping="Wrap" />
				</Grid>

				<!-- Bonus: the opening crawl, preserving the line breaks the API supplies. -->
				<StackPanel
					Margin="0,24,0,0"
					Visibility="{Binding HasOpeningCrawl, Converter={StaticResource BoolToVisibilityConverter}}">
					<TextBlock
						x:Uid="FilmDetailOpeningCrawlHeading"
						Style="{StaticResource SubtitleTextBlockStyle}"
						Text="Opening crawl" />
					<TextBlock
						Margin="0,8,0,0"
						LineHeight="22"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="{Binding OpeningCrawl}"
						TextWrapping="Wrap" />
				</StackPanel>

				<StackPanel Margin="0,24,0,0">
					<TextBlock
						x:Name="CharactersHeading"
						x:Uid="FilmDetailCharactersHeading"
						Style="{StaticResource SubtitleTextBlockStyle}"
						Text="Characters" />

					<ItemsControl
						Margin="0,8,0,0"
						AutomationProperties.LabeledBy="{Binding ElementName=CharactersHeading}"
						ItemsSource="{Binding RelatedResources}">
						<ItemsControl.ItemTemplate>
							<DataTemplate x:DataType="items:RelatedResourceItemViewModel">
								<TextBlock
									Padding="0,4"
									Style="{StaticResource BodyTextBlockStyle}"
									Text="{x:Bind Name}"
									TextWrapping="Wrap" />
							</DataTemplate>
						</ItemsControl.ItemTemplate>
					</ItemsControl>

					<TextBlock
						x:Uid="FilmDetailCharactersEmpty"
						Margin="0,4,0,0"
						Opacity="0.75"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="No characters are listed for this film."
						TextWrapping="Wrap"
						Visibility="{Binding HasNoRelatedResources, Converter={StaticResource BoolToVisibilityConverter}}" />

					<TextBlock
						Margin="0,4,0,0"
						Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
						Style="{StaticResource BodyTextBlockStyle}"
						Text="{Binding RelatedResourceErrorMessage}"
						TextWrapping="Wrap"
						Visibility="{Binding HasRelatedResourceError, Converter={StaticResource BoolToVisibilityConverter}}" />
				</StackPanel>
			</StackPanel>
		</ScrollViewer>

		<TextBlock
			Margin="24,16,24,0"
			VerticalAlignment="Top"
			Foreground="{ThemeResource SystemControlErrorTextForegroundBrush}"
			Style="{StaticResource BodyTextBlockStyle}"
			Text="{Binding ErrorMessage}"
			TextWrapping="Wrap"
			Visibility="{Binding HasError, Converter={StaticResource BoolToVisibilityConverter}}" />
	</Grid>
</Page>
